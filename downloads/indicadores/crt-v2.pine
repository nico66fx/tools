//@version=6
// =====================================================================================
//  CRT v2 
//  Candle Range Theory (CRT) — Non-repainting, no lookahead
// -------------------------------------------------------------------------------------
//  Model:
//    C1 = reference range candle (previous confirmed candle, or the highest-range
//         candle inside a configurable lookback). Its HIGH and LOW are the key levels.
//    C2 = sweep candle: takes liquidity OUTSIDE C1's range (sweeps the high or the low)
//         but CLOSES back INSIDE the range.
//           · Sweep of C1 LOW  + close inside  -> BULLISH setup (long)
//           · Sweep of C1 HIGH + close inside  -> BEARISH setup (short)
//    C3 = breakout confirmation within N bars, in the trade direction. If it does not
//         confirm (or price hits the sweep wick first, or the window expires) the setup
//         is invalidated.
//
//  Entry = C2 close (yellow line).  SL = sweep wick (C2 extreme).
//  TP1   = C1 midpoint (50%).       TP2 = opposite C1 extreme.
//
//  NO REPAINT: every decision is taken on CLOSED/CONFIRMED bars only
//  (barstate.isconfirmed). No request.security, no lookahead, no future references.
// =====================================================================================

indicator("CRT v2", shorttitle="CRT v2", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// =====================================================================================
//  1) INPUTS
// =====================================================================================
gLOGIC   = "CRT Logic"
minC1Range = input.float(10.0, "Min C1 Range (points, 0 = disabled)", minval=0.0, group=gLOGIC, tooltip="Minimum C1 high-low range in price points. 0 disables the filter.")
maxReclaim = input.float(50.0, "C2 Close MAX Reclaim (% of C1 range)", minval=0.0, maxval=100.0, group=gLOGIC, tooltip="C2 close must not reclaim beyond this % of the C1 range, measured from the swept extreme.")
minRR      = input.float(0.5,  "Min R:R (reward/risk)", minval=0.0, group=gLOGIC, tooltip="Minimum reward/risk to TP1. Reward = |TP1-entry|, Risk = |entry-SL|.")
maxBarsC3  = input.int(10,     "Max bars for C3 breakout", minval=1, group=gLOGIC, tooltip="Bars allowed after C2 for the C3 breakout to confirm; otherwise the setup is invalidated.")

gC1 = "C1 Source"
c1mode     = input.string("Previous candle", "C1 source", options=["Previous candle", "Highest range in lookback"], group=gC1)
c1lookback = input.int(10, "C1 lookback (bars)", minval=1, group=gC1, tooltip="Only used when C1 source = Highest range in lookback.")

gTREND = "Trend Filter"
useTrend   = input.bool(false, "Trend Filter (EMA directional)", group=gTREND, tooltip="If ON, longs require close > EMA and shorts require close < EMA.")
emaLen     = input.int(50, "Trend EMA length", minval=1, group=gTREND)

gVIS = "Visuals"
showHL     = input.bool(true,  "Show C1 H/L lines", group=gVIS)
showEntry  = input.bool(true,  "Show yellow entry line", group=gVIS)
showZones  = input.bool(true,  "Show SL/TP zones", group=gVIS)
showLabels = input.bool(false, "Show C1/C2/C3 labels", group=gVIS)
showMarker = input.bool(true,  "Show signal markers on ALL history (backtest)", group=gVIS, tooltip="Plots a small triangle at every historical signal. These are chart markers (not drawing objects), so they are NOT limited by 'Keep last N setups' or the 500-object cap — ideal for visual backtesting far back in time.")
keepN      = input.int(20, "Keep last N setups (detailed boxes/lines)", minval=1, group=gVIS)
lineLen    = input.int(10, "Line length forward (bars)", minval=1, group=gVIS)
boxLen     = input.int(6,  "SL/TP box length (bars)", minval=1, group=gVIS)

gALERT = "Alert Webhook"
qty      = input.float(1.0,  "Order quantity", minval=0.0, group=gALERT)
ticksize = input.float(0.25, "Tick size (price per tick)", minval=0.0000001, group=gALERT)

// =====================================================================================
//  2) C1 SELECTION (uses only closed bars: C1 is at [1] or inside the lookback window)
// =====================================================================================
float c1h = high[1]
float c1l = low[1]

if c1mode == "Highest range in lookback"
    float best = -1.0
    for i = 1 to c1lookback
        float r = high[i] - low[i]
        if not na(r) and r > best
            best := r
            c1h  := high[i]
            c1l  := low[i]

float rng   = c1h - c1l
float c1mid = (c1h + c1l) / 2.0
float ema   = ta.ema(close, emaLen)

// =====================================================================================
//  3) C2 DETECTION (current bar = candidate C2; evaluated at close)
// =====================================================================================
// Sweep + close back inside the range
bool bullSweep = low  < c1l and close > c1l and close < c1h
bool bearSweep = high > c1h and close < c1h and close > c1l

// Reclaim measured from the swept extreme, as % of the C1 range
float reclaimBull = rng > 0 ? (close - c1l) / rng * 100.0 : 100.0
float reclaimBear = rng > 0 ? (c1h - close) / rng * 100.0 : 100.0
bool passReclaimBull = reclaimBull <= maxReclaim
bool passReclaimBear = reclaimBear <= maxReclaim

// Min range filter
bool passRange = minC1Range <= 0.0 or (not na(rng) and rng >= minC1Range)

// Trend filter
bool trendBull = not useTrend or close > ema
bool trendBear = not useTrend or close < ema

// Levels
float entry   = close
float slBull  = low            // sweep wick (lowest point of C2)
float slBear  = high           // sweep wick (highest point of C2)
float tp1     = c1mid          // 50% of C1
float tp2Bull = c1h            // opposite extreme
float tp2Bear = c1l

// R:R to TP1
float rrBull = math.abs(entry - slBull) > 0 ? math.abs(tp1 - entry) / math.abs(entry - slBull) : 0.0
float rrBear = math.abs(entry - slBear) > 0 ? math.abs(tp1 - entry) / math.abs(entry - slBear) : 0.0
bool passRRBull = rrBull >= minRR
bool passRRBear = rrBear >= minRR

bool rawBull = bullSweep and passReclaimBull and passRange and trendBull and passRRBull
bool rawBear = bearSweep and passReclaimBear and passRange and trendBear and passRRBear

// Resolve the (rare) case where both fire on one bar: keep the larger sweep
bool newBull = rawBull and (not rawBear or (c1l - low)  >= (high - c1h))
bool newBear = rawBear and (not rawBull or (high - c1h) >  (c1l - low))

// Alert-condition series (non-repaint: true only on the confirmed close)
bool bullSig = newBull and barstate.isconfirmed
bool bearSig = newBear and barstate.isconfirmed

// =====================================================================================
//  4) SETUP TYPE + DRAWING STORAGE
// =====================================================================================
type Setup
    int   bar
    int   dir            // 1 = bull, -1 = bear
    float entry
    float sl
    float tp1
    float tp2
    float c1h
    float c1l
    int   status         // 0 = pending, 1 = confirmed (C3), -1 = invalid
    line  lnEntry
    line  lnH
    line  lnL
    line  lnTP1
    box   slBox
    box   tpBox
    label lblC1
    label lblC2
    label lblC3

var array<Setup> setups = array.new<Setup>()

delSetup(Setup s) =>
    if not na(s.lnEntry)
        line.delete(s.lnEntry)
    if not na(s.lnH)
        line.delete(s.lnH)
    if not na(s.lnL)
        line.delete(s.lnL)
    if not na(s.lnTP1)
        line.delete(s.lnTP1)
    if not na(s.slBox)
        box.delete(s.slBox)
    if not na(s.tpBox)
        box.delete(s.tpBox)
    if not na(s.lblC1)
        label.delete(s.lblC1)
    if not na(s.lblC2)
        label.delete(s.lblC2)
    if not na(s.lblC3)
        label.delete(s.lblC3)

// Colors
color colGray  = color.new(color.gray, 0)
color colYellow= color.new(color.yellow, 0)
color colRed   = color.new(color.red, 80)
color colGreen = color.new(color.green, 80)
color colTP1   = color.new(color.lime, 0)

// =====================================================================================
//  5) DATA WINDOW STATE (numeric encodings; string fields shown as codes)
//     Model / Last Signal:  1 = Bull(long)  -1 = Bear(short)  0 = none
// =====================================================================================
var int   vModel = 0
var float vRange = na
var float vMid   = na
var float vBody  = na     // C2 body in ticks
var float vLWick = na     // lower wick in ticks
var float vSWick = na     // upper wick in ticks
var int   vLast  = 0

// =====================================================================================
//  6) MAIN — runs on CONFIRMED bars only (no repaint)
// =====================================================================================
// price rounded to tick for the alert payload
r2tick(float x) => ticksize > 0 ? math.round(x / ticksize) * ticksize : x

if barstate.isconfirmed
    // ---- 6a) Update C3 status for pending setups (process BEFORE adding a new one) ----
    if array.size(setups) > 0
        for i = 0 to array.size(setups) - 1
            Setup s = array.get(setups, i)
            if s.status == 0
                int age = bar_index - s.bar
                if s.dir == 1
                    if low <= s.sl
                        s.status := -1                      // SL wick hit first
                    else if close > s.c1h
                        s.status := 1                       // breakout confirmed (C3)
                else
                    if high >= s.sl
                        s.status := -1
                    else if close < s.c1l
                        s.status := 1
                if s.status == 0 and age >= maxBarsC3
                    s.status := -1                          // window expired
                // React to a status change
                if s.status == 1
                    if not na(s.slBox)
                        box.set_bgcolor(s.slBox, color.new(color.red, 88))
                    if showLabels
                        s.lblC3 := label.new(bar_index, close, "C3 ✓", style=(s.dir == 1 ? label.style_label_down : label.style_label_up), color=color.new(color.green, 20), textcolor=color.white, size=size.tiny)
                else if s.status == -1
                    if not na(s.slBox)
                        box.set_bgcolor(s.slBox, color.new(color.gray, 88))
                    if not na(s.tpBox)
                        box.set_bgcolor(s.tpBox, color.new(color.gray, 88))
                    if not na(s.lnEntry)
                        line.set_color(s.lnEntry, color.new(color.gray, 40))

    // ---- 6b) New setup on this confirmed bar ----
    if newBull or newBear
        int   dir  = newBull ? 1 : -1
        float sl   = newBull ? slBull : slBear
        float tp2  = newBull ? tp2Bull : tp2Bear
        int   x1   = bar_index
        int   x2   = bar_index + lineLen
        int   xb   = bar_index + boxLen

        line leH  = na
        line leL  = na
        line leE  = na
        line leT  = na
        box  sBox = na
        box  tBox = na
        label la1 = na
        label la2 = na

        if showHL
            leH := line.new(x1, c1h, x2, c1h, xloc=xloc.bar_index, color=colGray, style=line.style_dashed, width=1)
            leL := line.new(x1, c1l, x2, c1l, xloc=xloc.bar_index, color=colGray, style=line.style_dashed, width=1)
        if showEntry
            leE := line.new(x1, entry, x2, entry, xloc=xloc.bar_index, color=colYellow, width=2)
        if showZones
            leT  := line.new(x1, tp1, x2, tp1, xloc=xloc.bar_index, color=colTP1, style=line.style_dotted, width=1)
            sBox := box.new(x1, math.max(entry, sl), xb, math.min(entry, sl), border_color=color.new(color.red, 40), bgcolor=colRed)
            tBox := box.new(x1, math.max(entry, tp2), xb, math.min(entry, tp2), border_color=color.new(color.green, 40), bgcolor=colGreen)
        if showLabels
            la1 := label.new(x1, c1h, "C1", style=label.style_label_down, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)
            la2 := label.new(bar_index, (dir == 1 ? low : high), "C2", style=(dir == 1 ? label.style_label_up : label.style_label_down), color=color.new(dir == 1 ? color.teal : color.maroon, 20), textcolor=color.white, size=size.tiny)

        Setup s = Setup.new(bar_index, dir, entry, sl, tp1, tp2, c1h, c1l, 0, leE, leH, leL, leT, sBox, tBox, la1, la2, na)
        array.push(setups, s)

        // Keep last N setups
        while array.size(setups) > keepN
            Setup old = array.shift(setups)
            delSetup(old)

        // Update Data Window state
        vModel := dir
        vRange := rng
        vMid   := c1mid
        vBody  := ticksize > 0 ? math.abs(close - open) / ticksize : na
        vLWick := ticksize > 0 ? (math.min(open, close) - low) / ticksize : na
        vSWick := ticksize > 0 ? (high - math.max(open, close)) / ticksize : na
        vLast  := dir

        // ---- 6c) Alert (JSON webhook payload) — fires on bar close only ----
        string side = dir == 1 ? "long" : "short"
        string j = '{"symbol":"' + syminfo.ticker + '","side":"' + side + '","entry":' + str.tostring(r2tick(entry)) + ',"sl":' + str.tostring(r2tick(sl)) + ',"tp1":' + str.tostring(r2tick(tp1)) + ',"tp2":' + str.tostring(r2tick(tp2)) + ',"qty":' + str.tostring(qty) + ',"ticksize":' + str.tostring(ticksize) + '}'
        alert(j, alert.freq_once_per_bar_close)

// =====================================================================================
//  7) ALERT CONDITIONS (static messages; non-repaint via confirmed series)
// =====================================================================================
alertcondition(bullSig, title="CRT v2 Long",  message="CRT v2 — LONG setup (C2 bullish sweep). Configure webhook via alert() for JSON payload.")
alertcondition(bearSig, title="CRT v2 Short", message="CRT v2 — SHORT setup (C2 bearish sweep). Configure webhook via alert() for JSON payload.")

// =====================================================================================
//  7b) HISTORY MARKERS (backtest) — chart shapes, NOT subject to the 500-object limit
//      so every historical signal stays visible no matter how far back you scroll.
// =====================================================================================
plotshape(showMarker and bullSig, title="Bull signal", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(showMarker and bearSig, title="Bear signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

// =====================================================================================
//  8) DATA WINDOW PLOTS
// =====================================================================================
plot(vModel,             "Model (1=Bull / -1=Bear)", display=display.data_window)
plot(vRange,             "C1 Range (pts)",           display=display.data_window)
plot(vMid,               "C1 Mid",                   display=display.data_window)
plot(vBody,              "C2 Body (ticks)",          display=display.data_window)
plot(vLWick,             "L Wick (ticks)",           display=display.data_window)
plot(vSWick,             "S Wick (ticks)",           display=display.data_window)
plot(vLast,              "Last Signal (1/-1)",       display=display.data_window)
plot(useTrend ? 1 : 0,   "Trend Filter (1=ON/0=OFF)",display=display.data_window)
